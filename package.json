{
  "name": "numberics",
  "version": "0.1.0",
  "description": "Numberics: ten number games (Fibonacci, Two, Three, Four, Five, Six, Seven, Nine, Fifteen, Sudoku). No build step.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "test": "node tests/run.js",
    "test:browser": "node tests/emulation.cjs && node tests/emu/run.cjs",
    "start": "python3 -m http.server 8070",
    "shots": "node tools/shots.cjs",
    "test:perf": "node tools/perf.cjs",
    "test:perf:quick": "PERF_RUNS=1 PERF_PLAY_MS=5000 node tools/perf.cjs"
  }
}
